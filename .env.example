# ---------------------------------------------------------------------------
# Copiez ce fichier en « .env » puis remplissez les valeurs.
#  cp .env.example .env
# Ne partagez jamais ce fichier : il contient votre clé secrète.
# En production (Render), ces variables se saisissent dans l'interface web
# de la plateforme, elles ne sont pas lues depuis ce fichier.
# ---------------------------------------------------------------------------

# --- Réglages Django ---------------------------------------------------------
# Clé secrète : sur Render, laissez Render la générer (generateValue: true).
DJANGO_SECRET_KEY=dev-seulement-changez-moi-en-production

# En production, mettez False.
DJANGO_DEBUG=True

# En production, indiquez votre domaine : analyse-conjoncturelle.onrender.com
DJANGO_ALLOWED_HOSTS=*

# Facultatif : Render le déduit de RENDER_EXTERNAL_HOSTNAME.
# DJANGO_CSRF_TRUSTED_ORIGINS=https://mon-app.onrender.com

# --- Base de données ---------------------------------------------------------
# Videz cette ligne en développement : le projet utilise alors SQLite.
# Sur Render, cette valeur est fournie automatiquement par la base créée.
# DATABASE_URL=postgresql://utilisateur:motdepasse@hote:5432/base

# --- Assistant « Le Perpétuel » (LLM en ligne) ------------------------------
# Clé gratuite sur https://console.groq.com/keys
# Sans clé, l'assistant bascule automatiquement en mode hors ligne
# (moteur de règles local sur la base de connaissances du projet).
GROQ_API_KEY=
ASSISTANT_MODEL=llama-3.3-70b-versatile
ASSISTANT_BASE_URL=https://api.groq.com/openai/v1

# --- Paramètres métier ------------------------------------------------------
MAX_ADMINS=2
RAPPORT_ORGANISATION=DEUS STAT, Analyse conjoncturelle

# --- Initialisation des comptes (usage en déploiement uniquement) -----------
# Renseignez cette variable dans Render pour créer votre administrateur.
# Format : identifiant:motdepasse
# ADMIN1_IDENTIFIANTS=monidentifiant:MonMotDePasse2027!
